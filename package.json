{
  "name": "laquake",
  "version": "1.2.2",
  "description": "地震预警接收与地震速报信息查询软件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:app": "electron-builder --win --x64 --dir",
    "build:installer": "node installer/build.js",
    "build": "npm run build:installer",
    "build:linux": "electron-builder --linux AppImage"
  },
  "keywords": [
    "earthquake",
    "warning",
    "EEW"
  ],
  "author": "LaQuake",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "electron-store": "^8.1.0",
    "ws": "^8.17.0"
  },
  "build": {
    "appId": "com.laquake.app",
    "productName": "LaQuake",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "Media/LaQuake.ico",
      "asar": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "Media/LaQuake.png",
      "asar": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "alert.html",
      "alert.js",
      "uninstaller/**/*",
      "src/**/*",
      "Media/**/*",
      "Fonts/**/*",
      "API列表.txt",
      "!Media参考/**/*"
    ],
    "extraResources": []
  },
  "allowScripts": {}
}
